{"type":"text","timestamp":1792850517855,"sessionID":"ses_000000","part":{"id":"prt_000000_text-0","sessionID":"ses_000000","messageID":"msg_000000","type":"text","text":"{\"unit_id\":\"house--ethics\",\"decision\":\"no_mapping\",\"no_mapping_reason\":\"Die Zuständigkeit betrifft ausschließlich interne Ethik- und Offenlegungsregeln für Mitglieder, Beamte und Beschäftigte des Repräsentantenhauses sowie bestimmter Legislativeinrichtungen und nicht die Regulierung privater Marktteilnehmer einer Industry.\",\"broad_scope_exception\":false,\"broad_scope_reason\":null,\"assignments\":[],\"sources\":[],\"label_uncertain\":false,\"uncertainty_note\":null}","time":{"start":1792850515240,"end":1792850517855}}}
